# Variables consommées par docker-compose.yml (copier en .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tontineapp

JWT_SECRET=change_me_secret
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=10

# --- Envoi des emails OTP via un vrai relais SMTP (ex. Gmail) ---
# Laisser vide pour utiliser Mailpit (capture locale, UI sur :8025).
# Gmail : créer un "mot de passe d'application" sur
#   https://myaccount.google.com/apppasswords  (2FA requise)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.adresse@gmail.com
SMTP_PASS=mot_de_passe_application_16_caracteres
SMTP_FROM=TontineApp <ton.adresse@gmail.com>
