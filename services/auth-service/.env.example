PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/tontineapp
JWT_SECRET=change_me_secret
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=10

# Seed du super_admin par défaut (script: npm run seed:admin).
# Le seed ne s'exécute QUE si aucun super_admin n'existe déjà.
ADMIN_EMAIL=admin@tontineapp.local
ADMIN_PASSWORD=change_me_admin_password
