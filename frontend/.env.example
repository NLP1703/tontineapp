# URLs des APIs consommées par le front.
#
# Laisser VIDE (recommandé) => appels relatifs same-origin, routés par :
#   - l'API Gateway Nginx en prod/cluster (port 8080) ;
#   - le proxy Vite en dev local (`npm run dev`, cf. vite.config.ts -> gateway 8080).
#
# Ne renseigner une URL absolue QUE pour taper en direct sur un microservice
# exposé sur l'hôte (dev sans gateway). Sinon le bundle figera ces URLs et
# cassera dès qu'on n'est plus dans ce contexte (ERR_CONNECTION_REFUSED).
VITE_AUTH_URL=
VITE_TONTINE_URL=
VITE_NOTIFY_URL=
